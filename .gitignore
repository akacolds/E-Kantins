config.js

-- 1. BUAT TABEL AKUN KANTIN (kantin_users)
CREATE TABLE IF NOT EXISTS public.kantin_users (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    kantin_id INT UNIQUE NOT NULL,
    nama_kantin TEXT NOT NULL,
    password TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. BUAT TABEL MENU (menu_kantin)
CREATE TABLE IF NOT EXISTS public.menu_kantin (
    id BIGINT PRIMARY KEY,
    kantin_id INT NOT NULL,
    nama_kantin TEXT NOT NULL,
    nama TEXT NOT NULL,
    kategori TEXT NOT NULL,
    description TEXT,
    harga INT NOT NULL,
    stok INT NOT NULL DEFAULT 0,
    foto TEXT,
    varian_list JSONB DEFAULT '["Original"]'::jsonb,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. BUAT TABEL PESANAN & CHAT (orders_kantin)
CREATE TABLE IF NOT EXISTS public.orders_kantin (
    id BIGINT PRIMARY KEY,
    kantin_id INT NOT NULL,
    nama_pemesan TEXT NOT NULL,
    info_pemesan TEXT NOT NULL,
    kode_unik_pemesan TEXT,
    user_key TEXT NOT NULL,
    metode TEXT NOT NULL,
    nama_menu TEXT NOT NULL,
    qty INT NOT NULL,
    varian TEXT NOT NULL,
    harga INT NOT NULL,
    catatan TEXT,
    waktu TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Menunggu',
    chats JSONB DEFAULT '[]'::jsonb,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 4. AKTIFKAN PUBLICATION REALTIME UNTUK ORDERS & MENU
-- (Agar notifikasi & chat otomatis muncul tanpa refresh)
ALTER PUBLICATION supabase_realtime ADD TABLE public.orders_kantin;
ALTER PUBLICATION supabase_realtime ADD TABLE public.menu_kantin;

-- 5. PENGATURAN ROW LEVEL SECURITY (RLS) & IZIN AKSES
ALTER TABLE public.kantin_users ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.menu_kantin ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.orders_kantin ENABLE ROW LEVEL SECURITY;

-- Izinkan akses Penuh (SELECT, INSERT, UPDATE, DELETE) untuk Role Anonim/Public
CREATE POLICY "Akses Penuh Kantin Users" ON public.kantin_users FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "Akses Penuh Menu Kantin" ON public.menu_kantin FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "Akses Penuh Orders Kantin" ON public.orders_kantin FOR ALL USING (true) WITH CHECK (true);

